# dependencies — regenerate with `npm install`, never copy between machines
node_modules/

# build output
dist/
tsconfig.tsbuildinfo

# per-machine Claude Code permission grants (absolute paths, not portable).
# .claude/launch.json IS committed — it is the shared dev-server config.
.claude/settings.local.json

# editor / OS noise
.DS_Store
Thumbs.db
*.log

# exported plans (personal data, regenerate from the app)
gradtree-plan.json

# generated by npm run shots:plans, an input to the screenshot driver
scripts/.shotplans.json

# packaged desktop builds — 1.5 GB of installers and unpacked Electron.
# Regenerate with `npm run desktop:build`; GitHub rejects files over 100 MB.
dist-desktop/
dist-desktop-*/
release/
build/

# The owner's real transcript: names, grades, GPA. Read only by npm run verify.
# The app ships data/student.json, which is deliberately blank.
data/student.mine.json
# Stale pre-reorganisation copy of the same transcript, unused by the app
/student.json

# Stale pre-reorganisation duplicates of files that now live in data/.
# files.zip also contained the owner's transcript.
/courses.json
/ai-engineering-minor-2026.json
/ee-bs-2026.json
/ge-abet.json
/files.zip
