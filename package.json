{
  "name": "gradtree",
  "private": true,
  "version": "0.1.0",
  "description": "Degree planner for a BYU-Idaho electrical-engineering student.",
  "author": "Sprout",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "tsx scripts/verify.ts",
    "audit": "tsx scripts/auditCatalog.ts",
    "icon": "tsx scripts/makeIcon.ts",
    "desktop": "cross-env VITE_PORT=5175 VITE_DEV_SERVER_URL=http://localhost:5175 concurrently -k -n vite,app -c cyan,magenta \"vite\" \"electron .\"",
    "desktop:preview": "npm run build && electron .",
    "desktop:build": "npm run build && node scripts/packDesktop.mjs",
    "desktop:fix": "node node_modules/electron/install.js",
    "desktop:clean": "node scripts/cleanDesktop.mjs",
    "shortcut": "npm run build && node scripts/makeShortcut.mjs",
    "bench": "tsx scripts/parserBench.ts",
    "harvest": "tsx scripts/harvestCatalog.ts",
    "coverage": "tsx scripts/parseCoverage.ts",
    "merge": "tsx scripts/buildCourses.ts",
    "schedule": "tsx scripts/harvestSchedule.ts",
    "harvest:programs": "tsx scripts/harvestPrograms.ts",
    "bench:programs": "tsx scripts/programBench.ts",
    "merge:programs": "tsx scripts/buildPrograms.ts",
    "audit:programs": "tsx scripts/auditPrograms.ts",
    "sweep": "tsx scripts/sweepPrograms.ts",
    "verify:catalog": "tsx scripts/verifyCatalog.ts",
    "personas": "tsx scripts/personas.ts",
    "ui:check": "electron scripts/checkUi.cjs",
    "tree:check": "electron scripts/checkTree.cjs",
    "shots": "electron scripts/shots.cjs",
    "tree:stats": "tsx scripts/treeStats.ts",
    "welcome:check": "electron scripts/checkWelcome.cjs",
    "shots:plans": "tsx scripts/makeShotPlans.ts",
    "screenshots": "npm run shots:plans && electron scripts/screenshots.cjs"
  },
  "build": {
    "appId": "com.gradtree.planner",
    "productName": "Sprout",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Sprout"
    }
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@xyflow/react": "^12.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "electron@43.4.0": true
  }
}
